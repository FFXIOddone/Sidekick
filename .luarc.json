{
    "runtime.version": "LuaJIT",
    "runtime.path": ["?.lua"],
    "diagnostics.globals": [
        "addon",
        "ashita",
        "AshitaCore",
        "GetEntity",
        "GetPlayerEntity",
        "struct",
        "switch",
